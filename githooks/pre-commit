#!/bin/bash

# Fails the commit on a dead `/skill` reference under claude/skills. The checker
# ships with the audit-skills skill, which comes from a private clone, so a
# machine without it skips this step.
REPO="$(git rev-parse --show-toplevel)"
CHECKER="$HOME/.claude/skills/audit-skills/scripts/check-skill-references.mjs"
if [ -f "$CHECKER" ] && command -v node >/dev/null 2>&1; then
  node "$CHECKER" "$REPO/claude/skills" || exit 1
else
  echo "pre-commit: skill reference check skipped (audit-skills or node missing)"
fi

# Fails when claude/suggest-skills.md and the user-invoked skills disagree.
python3 -I "$REPO/lib/check-suggest-skills.py" || exit 1

# Warns, never fails: a replaced symlink is live state, not part of this commit.
"$REPO/lib/check-links.sh" || echo "pre-commit: the paths above are not linked to this repo"
exit 0
