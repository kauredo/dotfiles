#!/bin/bash

# Fails the commit on a dead `/skill` reference under claude/skills.
REPO="$(git rev-parse --show-toplevel)"
if command -v node >/dev/null 2>&1; then
  node "$REPO/claude/skills/audit/scripts/check-skill-references.mjs" "$REPO/claude/skills" || exit 1
else
  echo "pre-commit: skill reference check skipped (node missing)"
fi

# Fails when claude/suggest-skills.md and the user-invoked skills disagree.
python3 -I "$REPO/lib/check-suggest-skills.py" || exit 1

# Warns, never fails: a replaced symlink is live state, not part of this commit.
"$REPO/lib/check-links.sh" || echo "pre-commit: the paths above are not linked to this repo"
exit 0
